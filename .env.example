# ==============================================================================
# NOVA - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local and update the values with your actual configuration.
# ⚠️ NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SITE CONFIGURATION
# ------------------------------------------------------------------------------
# What it is: Public base URL of the application. Used for OAuth redirects and canonical links.
# Where to get it: http://localhost:3000 for local development, or your production URL (e.g., https://nova.vercel.app).
# Requirement: REQUIRED
# Scope: CLIENT-SAFE (Exposed to the browser via NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (AUTHENTICATION, DATABASE, STORAGE)
# ------------------------------------------------------------------------------
# What it is: The HTTPS API endpoint for your Supabase project.
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project URL
# Requirement: REQUIRED
# Scope: CLIENT-SAFE (Exposed to the browser via NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=

# What it is: The anonymous public API key. Subject to Row Level Security (RLS) policies.
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project API keys -> "anon" "public"
# Requirement: REQUIRED
# Scope: CLIENT-SAFE (Exposed to the browser via NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# What it is: The service role secret key. Bypasses Row Level Security (RLS) with full admin privileges.
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project API keys -> "service_role" "secret"
# Requirement: REQUIRED
# Scope: SERVER-ONLY (CRITICAL: Never expose to browser, client bundles, or NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# What it is: API key for Google Gemini Generative AI services.
# Where to get it: Google AI Studio (https://aistudio.google.com/app/apikey)
# Requirement: REQUIRED
# Scope: SERVER-ONLY (Never expose to browser or client bundles)
GEMINI_API_KEY=

# What it is: Model identifier for conversational and text generation tasks.
# Where to get it: Google Gemini Model Directory (e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
# Requirement: OPTIONAL (Defaults to gemini-3.5-flash-lite if omitted)
# Scope: SERVER-ONLY
GEMINI_CHAT_MODEL="gemini-3.5-flash-lite"

# What it is: Model identifier for generating vector embeddings for semantic search.
# Where to get it: Google Gemini Embeddings Directory (e.g., text-embedding-004)
# Requirement: OPTIONAL (Defaults to text-embedding-004 if omitted)
# Scope: SERVER-ONLY
GEMINI_EMBEDDING_MODEL="


# ------------------------------------------------------------------------------
# 4. SPLINE 3D SCENE CONFIGURATION
# ------------------------------------------------------------------------------
# What it is: Public URL of the exported Spline 3D scene file (.splinecode).
# Where to get it: Spline Editor (https://spline.design) -> Export -> Code -> Viewer URL
# Requirement: OPTIONAL (The app falls back gracefully to a CSS/SVG animation if empty)
# Scope: CLIENT-SAFE (Exposed to the browser via NEXT_PUBLIC_)
NEXT_PUBLIC_SPLINE_SCENE_URL="https://prod.spline.design/your_scene_id/scene.splinecode"


# ------------------------------------------------------------------------------
# 5. UPSTASH REDIS CONFIGURATION (RATE LIMITING & CACHING)
# ------------------------------------------------------------------------------
# What it is: REST API endpoint for Upstash Serverless Redis.
# Where to get it: Upstash Console (https://console.upstash.com) -> Databases -> Details -> REST API -> UPSTASH_REDIS_REST_URL
# Requirement: OPTIONAL (If unset, the app falls back to in-memory rate limiting in dev)
# Scope: SERVER-ONLY
UPSTASH_REDIS_REST_URL=""

# What it is: REST API read/write token for Upstash Serverless Redis.
# Where to get it: Upstash Console (https://console.upstash.com) -> Databases -> Details -> REST API -> UPSTASH_REDIS_REST_TOKEN
# Requirement: OPTIONAL (If unset, the app falls back to in-memory rate limiting in dev)
# Scope: SERVER-ONLY
UPSTASH_REDIS_REST_TOKEN=""
